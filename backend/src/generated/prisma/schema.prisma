generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  New
  Engaged
  ProposalSent
  ClosedWon
  ClosedLost
}

model Lead {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  status    LeadStatus @default(New)
  createdAt DateTime   @default(now())
}
